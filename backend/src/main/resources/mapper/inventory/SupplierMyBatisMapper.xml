<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.khahnm04.ecommerce.modules.inventory.mapper.mybatis.SupplierMyBatisMapper">

    <resultMap id="SupplierResponseMap" type="com.khahnm04.ecommerce.modules.inventory.dto.response.SupplierResponse">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="contactPerson" column="contact_person"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="address" column="address"/>
        <result property="taxCode" column="tax_code"/>
        <result property="paymentTerms" column="payment_terms"/>
        <result property="status" column="status" javaType="com.khahnm04.ecommerce.modules.inventory.enums.SupplierStatus"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <sql id="baseColumns">
        s.id,
        s.code,
        s.name,
        s.contact_person,
        s.phone,
        s.email,
        s.address,
        s.tax_code,
        s.payment_terms,
        s.status,
        s.created_at,
        s.deleted_at
    </sql>

    <sql id="updatedFields">
        s.updated_at,
        uc.full_name AS created_by,
        uu.full_name AS updated_by
    </sql>

    <sql id="baseFromJoinForSelect">
        FROM suppliers s
        LEFT JOIN users uc ON s.created_by = uc.id
        LEFT JOIN users uu ON s.updated_by = uu.id
    </sql>

    <sql id="baseFromJoinForCount">
        FROM suppliers s
    </sql>

    <sql id="whereClause">
        <where>
            <!-- Deleted filter -->
            <choose>
                <when test="isDeleted">
                    AND s.deleted_at IS NOT NULL
                </when>
                <otherwise>
                    AND s.deleted_at IS NULL
                </otherwise>
            </choose>

            <!-- Status filter -->
            <if test="status != null">
                AND s.status = #{status}
            </if>

            <!-- Keyword search -->
            <if test="keyword != null and keyword != ''">
                AND (
                    s.code LIKE CONCAT('%', #{keyword}, '%')
                    OR s.name LIKE CONCAT('%', #{keyword}, '%')
                    OR s.contact_person LIKE CONCAT('%', #{keyword}, '%')
                    OR s.phone LIKE CONCAT('%', #{keyword}, '%')
                    OR s.email LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>

            <!-- Date range filter -->
            <if test="startDate != null">
                AND s.created_at >= #{startDate}
            </if>

            <!-- Date range filter -->
            <if test="endDate != null">
                <![CDATA[
                AND s.created_at <= DATE_ADD(#{endDate}, INTERVAL 1 DAY) - INTERVAL 1 SECOND
                ]]>
            </if>
        </where>
    </sql>

    <select id="findAllWithFilterAndSearch" resultMap="SupplierResponseMap">
        SELECT
            <include refid="baseColumns"/>,
            <include refid="updatedFields"/>
        <include refid="baseFromJoinForSelect"/>
        <include refid="whereClause"/>
        ORDER BY ${sortColumn} ${sortDirection}
        LIMIT #{limit}
        OFFSET #{offset}
    </select>

    <select id="countWithFilterAndSearch" resultType="long">
        SELECT COUNT(*)
        <include refid="baseFromJoinForCount"/>
        <include refid="whereClause"/>
    </select>

</mapper>
