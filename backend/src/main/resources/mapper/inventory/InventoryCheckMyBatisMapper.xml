<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.khahnm04.ecommerce.modules.inventory.mapper.mybatis.InventoryCheckMyBatisMapper">

    <resultMap id="InventoryCheckResponseMap" type="com.khahnm04.ecommerce.modules.inventory.dto.response.InventoryCheckResponse">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="warehouseId" column="warehouse_id"/>
        <result property="warehouseName" column="warehouse_name"/>
        <result property="checkDate" column="check_date"/>
        <result property="checkType" column="check_type"/>
        <result property="systemQuantity" column="system_quantity"/>
        <result property="actualQuantity" column="actual_quantity"/>
        <result property="difference" column="difference"/>
        <result property="status" column="status" javaType="com.khahnm04.ecommerce.modules.inventory.enums.InventoryCheckStatus"/>
        <result property="notes" column="notes"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="InventoryCheckDetailResponseMap" type="com.khahnm04.ecommerce.modules.inventory.dto.response.InventoryCheckDetailResponse">
        <id property="id" column="id"/>
        <result property="productVariantId" column="product_variant_id"/>
        <result property="productVariantSku" column="product_variant_sku"/>
        <result property="productVariantName" column="product_variant_name"/>
        <result property="systemQuantity" column="system_quantity"/>
        <result property="actualQuantity" column="actual_quantity"/>
        <result property="difference" column="difference"/>
        <result property="reason" column="reason"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="baseColumns">
        ic.id,
        ic.code,
        ic.warehouse_id,
        ic.check_date,
        ic.check_type,
        ic.system_quantity,
        ic.actual_quantity,
        ic.difference,
        ic.status,
        ic.notes,
        ic.created_at,
        ic.deleted_at
    </sql>

    <sql id="updatedFields">
        ic.updated_at,
        w.name AS warehouse_name
    </sql>

    <sql id="baseFromJoinForSelect">
        FROM inventory_checks ic
        LEFT JOIN warehouses w ON ic.warehouse_id = w.id
    </sql>

    <sql id="baseFromJoinForCount">
        FROM inventory_checks ic
    </sql>

    <sql id="whereClause">
        <where>
            AND ic.deleted_at IS NULL

            <!-- Warehouse filter -->
            <if test="warehouseId != null">
                AND ic.warehouse_id = #{warehouseId}
            </if>

            <!-- Check type filter -->
            <if test="checkType != null and checkType != ''">
                AND ic.check_type = #{checkType}
            </if>

            <!-- Status filter -->
            <if test="status != null">
                AND ic.status = #{status}
            </if>

            <!-- Keyword search -->
            <if test="keyword != null and keyword != ''">
                AND (
                    ic.code LIKE CONCAT('%', #{keyword}, '%')
                    OR ic.notes LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>

            <!-- Date range filter -->
            <if test="startDate != null">
                AND ic.check_date >= #{startDate}
            </if>

            <!-- Date range filter -->
            <if test="endDate != null">
                <![CDATA[
                AND ic.check_date <= DATE_ADD(#{endDate}, INTERVAL 1 DAY) - INTERVAL 1 SECOND
                ]]>
            </if>
        </where>
    </sql>

    <select id="findAllWithFilterAndSearch" resultMap="InventoryCheckResponseMap">
        SELECT
            <include refid="baseColumns"/>,
            <include refid="updatedFields"/>
        <include refid="baseFromJoinForSelect"/>
        <include refid="whereClause"/>
        ORDER BY ${sortColumn} ${sortDirection}
        LIMIT #{limit}
        OFFSET #{offset}
    </select>

    <select id="countWithFilterAndSearch" resultType="long">
        SELECT COUNT(*)
        <include refid="baseFromJoinForCount"/>
        <include refid="whereClause"/>
    </select>

    <select id="findDetailsByCheckId" resultMap="InventoryCheckDetailResponseMap">
        SELECT
            icd.id,
            icd.product_variant_id,
            pv.sku AS product_variant_sku,
            pv.name AS product_variant_name,
            icd.system_quantity,
            icd.actual_quantity,
            icd.difference,
            icd.reason,
            icd.created_at
        FROM inventory_check_details icd
        LEFT JOIN product_variants pv ON icd.product_variant_id = pv.id
        WHERE icd.inventory_check_id = #{inventoryCheckId}
        ORDER BY pv.sku ASC
    </select>

    <select id="countSerialsByWarehouseAndVariant" resultType="int">
        SELECT COUNT(*)
        FROM serial_numbers sn
        WHERE sn.warehouse_id = #{warehouseId}
          AND sn.product_variant_id = #{productVariantId}
          AND sn.status = 'IN_STOCK'
          AND sn.deleted_at IS NULL
    </select>

</mapper>
