<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.khahnm04.ecommerce.modules.catalog.mapper.mybaits.ProductVariantMyBatisMapper">

    <resultMap id="ProductVariantResponseMap" type="com.khahnm04.ecommerce.modules.catalog.dto.response.ProductVariantResponse">
        <id property="id" column="id"/>
        <result property="productId" column="product_id"/>
        <result property="productName" column="product_name"/>
        <result property="sku" column="sku"/>
        <result property="name" column="name"/>
        <result property="price" column="price"/>
        <result property="oldPrice" column="old_price"/>
        <result property="image" column="image"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <sql id="baseColumns">
        pv.id,
        pv.product_id,
        pv.sku,
        pv.name,
        pv.price,
        pv.old_price,
        pv.image,
        pv.status,
        pv.created_at,
        pv.deleted_at
    </sql>

    <sql id="updatedFields">
        pv.updated_at,
        p.name AS product_name,
        uc.full_name AS created_by,
        uu.full_name AS updated_by
    </sql>

    <sql id="baseFromJoinForSelect">
        FROM product_variants pv
        INNER JOIN products p ON pv.product_id = p.id
        LEFT JOIN users uc ON pv.created_by = uc.id
        LEFT JOIN users uu ON pv.updated_by = uu.id
    </sql>

    <sql id="baseFromJoinForCount">
        FROM product_variants pv
    </sql>

    <sql id="whereClause">
        <where>
            <!-- Deleted filter -->
            <choose>
                <when test="isDeleted">
                    AND pv.deleted_at IS NOT NULL
                </when>
                <otherwise>
                    AND pv.deleted_at IS NULL
                </otherwise>
            </choose>

            <!-- Product filter -->
            <if test="productId != null">
                AND pv.product_id = #{productId}
            </if>

            <!-- Keyword search -->
            <if test="keyword != null and keyword != ''">
                AND (
                    pv.name LIKE CONCAT('%', #{keyword}, '%')
                    OR pv.sku LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>

            <!-- Date range filter -->
            <if test="startDate != null">
                AND pv.created_at >= #{startDate}
            </if>

            <!-- Date range filter -->
            <if test="endDate != null">
                <![CDATA[
                AND pv.created_at <= DATE_ADD(#{endDate}, INTERVAL 1 DAY) - INTERVAL 1 SECOND
                ]]>
            </if>
        </where>
    </sql>

    <select id="findAllWithFilterAndSearch" resultMap="ProductVariantResponseMap">
        SELECT
            <include refid="baseColumns"/>,
            <include refid="updatedFields"/>
        <include refid="baseFromJoinForSelect"/>
        <include refid="whereClause"/>
        ORDER BY ${sortColumn} ${sortDirection}
        LIMIT #{limit}
        OFFSET #{offset}
    </select>

    <select id="countWithFilterAndSearch" resultType="long">
        SELECT COUNT(*)
        <include refid="baseFromJoinForCount"/>
        <include refid="whereClause"/>
    </select>

</mapper>
