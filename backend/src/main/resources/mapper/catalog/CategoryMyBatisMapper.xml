<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.khahnm04.ecommerce.modules.catalog.mapper.mybaits.CategoryMyBatisMapper">

    <resultMap id="CategoryResponseMap" type="com.khahnm04.ecommerce.modules.catalog.dto.response.CategoryResponse">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="slug" column="slug"/>
        <result property="description" column="description"/>
        <result property="iconUrl" column="icon_url"/>
        <result property="bannerUrl" column="banner_url"/>
        <result property="parentId" column="parent_id"/>
        <result property="parentName" column="parent_name"/>
        <result property="position" column="position"/>
        <result property="level" column="level"/>
        <result property="path" column="path"/>
        <result property="metaTitle" column="meta_title"/>
        <result property="metaDescription" column="meta_description"/>
        <result property="metaKeywords" column="meta_keywords"/>
        <result property="status" column="status" typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <sql id="baseColumns">
        c.id,
        c.name,
        c.slug,
        c.description,
        c.icon_url,
        c.banner_url,
        c.parent_id,
        c.position,
        c.level,
        c.path,
        c.meta_title,
        c.meta_description,
        c.meta_keywords,
        c.status,
        c.created_at,
        c.deleted_at
    </sql>

    <sql id="updatedFields">
        c.updated_at,
        pc.name AS parent_name,
        uc.full_name AS created_by,
        uu.full_name AS updated_by
    </sql>

    <sql id="baseFromJoinForSelect">
        FROM categories c
        LEFT JOIN categories pc ON c.parent_id = pc.id
        LEFT JOIN users uc ON c.created_by = uc.id
        LEFT JOIN users uu ON c.updated_by = uu.id
    </sql>

    <sql id="baseFromJoinForCount">
        FROM categories c
    </sql>

    <sql id="whereClause">
        <where>
            <!-- Deleted filter -->
            <choose>
                <when test="isDeleted">
                    AND c.deleted_at IS NOT NULL
                </when>
                <otherwise>
                    AND c.deleted_at IS NULL
                </otherwise>
            </choose>

            <!-- Keyword search: search in name, slug -->
            <if test="keyword != null and keyword != ''">
                AND (
                    c.name LIKE CONCAT('%', #{keyword}, '%')
                    OR c.slug LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>

            <!-- Status filter -->
            <if test="status != null">
                AND c.status = #{status}
            </if>

            <!-- Parent filter -->
            <if test="parentId != null">
                AND c.parent_id = #{parentId}
            </if>

            <!-- Date range filter -->
            <if test="startDate != null">
                AND c.created_at >= #{startDate}
                AND c.updated_at >= #{startDate}
            </if>

            <!-- Date range filter -->
            <if test="endDate != null">
                <![CDATA[
                AND c.created_at <= DATE_ADD(#{endDate}, INTERVAL 1 DAY) - INTERVAL 1 SECOND
                AND c.updated_at <= DATE_ADD(#{endDate}, INTERVAL 1 DAY) - INTERVAL 1 SECOND
                ]]>
            </if>
        </where>
    </sql>

    <select id="findAllWithFilterAndSearch" resultMap="CategoryResponseMap">
        SELECT
            <include refid="baseColumns"/>,
            <include refid="updatedFields"/>
        <include refid="baseFromJoinForSelect"/>
        <include refid="whereClause"/>
        ORDER BY ${sortColumn} ${sortDirection}
        LIMIT #{limit}
        OFFSET #{offset}
    </select>

    <select id="countWithFilterAndSearch" resultType="long">
        SELECT COUNT(*)
        <include refid="baseFromJoinForCount"/>
        <include refid="whereClause"/>
    </select>

</mapper>
