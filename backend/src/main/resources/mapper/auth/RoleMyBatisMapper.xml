<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.khahnm04.ecommerce.modules.auth.mapper.mybaits.RoleMyBatisMapper">

    <resultMap id="RoleResponseMap" type="com.khahnm04.ecommerce.modules.auth.dto.response.RoleResponse">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <sql id="baseColumns">
        r.id,
        r.code,
        r.name,
        r.description,
        r.created_at,
        r.deleted_at
    </sql>

    <sql id="updatedFields">
        r.updated_at,
        uc.full_name AS created_by,
        uu.full_name AS updated_by
    </sql>

    <sql id="baseFromJoinForSelect">
        FROM roles r
        LEFT JOIN users uc ON r.created_by = uc.id
        LEFT JOIN users uu ON r.updated_by = uu.id
    </sql>

    <sql id="baseFromJoinForCount">
        FROM roles r
    </sql>

    <sql id="whereClause">
        <where>
            <!-- Deleted filter -->
            <choose>
                <when test="isDeleted">
                    AND r.deleted_at IS NOT NULL
                </when>
                <otherwise>
                    AND r.deleted_at IS NULL
                </otherwise>
            </choose>

            <!-- Keyword search -->
            <if test="keyword != null and keyword != ''">
                AND (
                    r.code LIKE CONCAT('%', #{keyword}, '%')
                    OR r.name LIKE CONCAT('%', #{keyword}, '%')
                    OR r.description LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
        </where>
    </sql>

    <select id="findAllWithFilterAndSearch" resultMap="RoleResponseMap">
        SELECT
            <include refid="baseColumns"/>,
            <include refid="updatedFields"/>
        <include refid="baseFromJoinForSelect"/>
        <include refid="whereClause"/>
        ORDER BY ${sortColumn} ${sortDirection}
        LIMIT #{limit}
        OFFSET #{offset}
    </select>

    <select id="countWithFilterAndSearch" resultType="long">
        SELECT COUNT(*)
        <include refid="baseFromJoinForCount"/>
        <include refid="whereClause"/>
    </select>

</mapper>
