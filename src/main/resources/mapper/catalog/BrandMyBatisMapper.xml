<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.khahnm04.ecommerce.modules.catalog.mapper.mybaits.BrandMyBatisMapper">

    <resultMap id="BrandResponseMap" type="com.khahnm04.ecommerce.modules.catalog.dto.response.BrandResponse">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="slug" column="slug"/>
        <result property="description" column="description"/>
        <result property="logoUrl" column="logo_url"/>
        <result property="country" column="country"/>
        <result property="websiteUrl" column="website_url"/>
        <result property="metaTitle" column="meta_title"/>
        <result property="metaDescription" column="meta_description"/>
        <result property="metaKeywords" column="meta_keywords"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <sql id="baseColumns">
        b.id,
        b.name,
        b.slug,
        b.description,
        b.logo_url,
        b.country,
        b.website_url,
        b.meta_title,
        b.meta_description,
        b.meta_keywords,
        b.created_at,
        b.deleted_at
    </sql>

    <sql id="updatedFields">
        b.updated_at,
        uc.full_name AS created_by,
        uu.full_name AS updated_by
    </sql>

    <sql id="baseFromJoinForSelect">
        FROM brands b
        LEFT JOIN users uc ON b.created_by = uc.id
        LEFT JOIN users uu ON b.updated_by = uu.id
    </sql>

    <sql id="baseFromJoinForCount">
        FROM brands b
    </sql>

    <sql id="whereClause">
        <where>
            <!-- Deleted filter -->
            <choose>
                <when test="isDeleted">
                    AND b.deleted_at IS NOT NULL
                </when>
                <otherwise>
                    AND b.deleted_at IS NULL
                </otherwise>
            </choose>

            <!-- Keyword search: search in name, slug -->
            <if test="keyword != null and keyword != ''">
                AND (
                    b.name LIKE CONCAT('%', #{keyword}, '%')
                    OR b.slug LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>

            <!-- Date range filter -->
            <if test="startDate != null">
                AND b.created_at >= #{startDate}
                AND b.updated_at >= #{startDate}
            </if>

            <!-- Date range filter -->
            <if test="endDate != null">
                <![CDATA[
                AND b.created_at <= DATE_ADD(#{endDate}, INTERVAL 1 DAY) - INTERVAL 1 SECOND
                AND b.updated_at <= DATE_ADD(#{endDate}, INTERVAL 1 DAY) - INTERVAL 1 SECOND
                ]]>
            </if>
        </where>
    </sql>

    <select id="findAllWithFilterAndSearch" resultMap="BrandResponseMap">
        SELECT
            <include refid="baseColumns"/>,
            <include refid="updatedFields"/>
        <include refid="baseFromJoinForSelect"/>
        <include refid="whereClause"/>
        ORDER BY ${sortColumn} ${sortDirection}
        LIMIT #{limit}
        OFFSET #{offset}
    </select>

    <select id="countWithFilterAndSearch" resultType="long">
        SELECT COUNT(*)
        <include refid="baseFromJoinForCount"/>
        <include refid="whereClause"/>
    </select>

</mapper>
