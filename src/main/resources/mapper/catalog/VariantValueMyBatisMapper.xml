<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.khahnm04.ecommerce.modules.catalog.mapper.mybaits.VariantValueMyBatisMapper">

    <resultMap id="VariantValueResponseMap" type="com.khahnm04.ecommerce.modules.catalog.dto.response.VariantValueResponse">
        <id property="id" column="id"/>
        <result property="variantId" column="variant_id"/>
        <result property="variantName" column="variant_name"/>
        <result property="code" column="code"/>
        <result property="value" column="value"/>
        <result property="displayOrder" column="display_order"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <sql id="baseColumns">
        vv.id,
        vv.variant_id,
        vv.code,
        vv.value,
        vv.display_order,
        vv.created_at,
        vv.deleted_at
    </sql>

    <sql id="updatedFields">
        vv.updated_at,
        v.name AS variant_name,
        uc.full_name AS created_by,
        uu.full_name AS updated_by
    </sql>

    <sql id="baseFromJoinForSelect">
        FROM variant_values vv
        INNER JOIN variants v ON vv.variant_id = v.id
        LEFT JOIN users uc ON vv.created_by = uc.id
        LEFT JOIN users uu ON vv.updated_by = uu.id
    </sql>

    <sql id="baseFromJoinForCount">
        FROM variant_values vv
    </sql>

    <sql id="whereClause">
        <where>
            <!-- Deleted filter -->
            <choose>
                <when test="isDeleted">
                    AND vv.deleted_at IS NOT NULL
                </when>
                <otherwise>
                    AND vv.deleted_at IS NULL
                </otherwise>
            </choose>

            <!-- Variant filter -->
            <if test="variantId != null">
                AND vv.variant_id = #{variantId}
            </if>

            <!-- Keyword search -->
            <if test="keyword != null and keyword != ''">
                AND (
                    vv.value LIKE CONCAT('%', #{keyword}, '%')
                    OR vv.code LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>

            <!-- Date range filter -->
            <if test="startDate != null">
                AND vv.created_at >= #{startDate}
            </if>

            <!-- Date range filter -->
            <if test="endDate != null">
                <![CDATA[
                AND vv.created_at <= DATE_ADD(#{endDate}, INTERVAL 1 DAY) - INTERVAL 1 SECOND
                ]]>
            </if>
        </where>
    </sql>

    <select id="findAllWithFilterAndSearch" resultMap="VariantValueResponseMap">
        SELECT
            <include refid="baseColumns"/>,
            <include refid="updatedFields"/>
        <include refid="baseFromJoinForSelect"/>
        <include refid="whereClause"/>
        ORDER BY ${sortColumn} ${sortDirection}
        LIMIT #{limit}
        OFFSET #{offset}
    </select>

    <select id="countWithFilterAndSearch" resultType="long">
        SELECT COUNT(*)
        <include refid="baseFromJoinForCount"/>
        <include refid="whereClause"/>
    </select>

</mapper>
