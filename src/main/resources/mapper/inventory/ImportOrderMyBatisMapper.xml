<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.khahnm04.ecommerce.modules.inventory.mapper.mybatis.ImportOrderMyBatisMapper">

    <resultMap id="ImportOrderResponseMap" type="com.khahnm04.ecommerce.modules.inventory.dto.response.ImportOrderResponse">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="warehouseId" column="warehouse_id"/>
        <result property="warehouseName" column="warehouse_name"/>
        <result property="supplierId" column="supplier_id"/>
        <result property="supplierName" column="supplier_name"/>
        <result property="importDate" column="import_date"/>
        <result property="totalQuantity" column="total_quantity"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="status" column="status" javaType="com.khahnm04.ecommerce.modules.inventory.enums.ImportOrderStatus"/>
        <result property="notes" column="notes"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <resultMap id="ImportDetailResponseMap" type="com.khahnm04.ecommerce.modules.inventory.dto.response.ImportDetailResponse">
        <id property="id" column="id"/>
        <result property="productVariantId" column="product_variant_id"/>
        <result property="productVariantSku" column="product_variant_sku"/>
        <result property="productVariantName" column="product_variant_name"/>
        <result property="serialNumberId" column="serial_number_id"/>
        <result property="serialCode" column="serial_code"/>
        <result property="unitPrice" column="unit_price"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="baseColumns">
        io.id,
        io.code,
        io.warehouse_id,
        io.supplier_id,
        io.import_date,
        io.total_quantity,
        io.total_amount,
        io.status,
        io.notes,
        io.created_at,
        io.deleted_at
    </sql>

    <sql id="updatedFields">
        io.updated_at,
        w.name AS warehouse_name,
        s.name AS supplier_name,
        uc.full_name AS created_by,
        uu.full_name AS updated_by
    </sql>

    <sql id="baseFromJoinForSelect">
        FROM import_orders io
        LEFT JOIN warehouses w ON io.warehouse_id = w.id
        LEFT JOIN suppliers s ON io.supplier_id = s.id
        LEFT JOIN users uc ON io.created_by = uc.id
        LEFT JOIN users uu ON io.updated_by = uu.id
    </sql>

    <sql id="baseFromJoinForCount">
        FROM import_orders io
    </sql>

    <sql id="whereClause">
        <where>
            AND io.deleted_at IS NULL

            <!-- Warehouse filter -->
            <if test="warehouseId != null">
                AND io.warehouse_id = #{warehouseId}
            </if>

            <!-- Supplier filter -->
            <if test="supplierId != null">
                AND io.supplier_id = #{supplierId}
            </if>

            <!-- Status filter -->
            <if test="status != null">
                AND io.status = #{status}
            </if>

            <!-- Keyword search -->
            <if test="keyword != null and keyword != ''">
                AND (
                    io.code LIKE CONCAT('%', #{keyword}, '%')
                    OR io.notes LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>

            <!-- Date range filter -->
            <if test="startDate != null">
                AND io.import_date >= #{startDate}
            </if>

            <!-- Date range filter -->
            <if test="endDate != null">
                <![CDATA[
                AND io.import_date <= DATE_ADD(#{endDate}, INTERVAL 1 DAY) - INTERVAL 1 SECOND
                ]]>
            </if>
        </where>
    </sql>

    <select id="findAllWithFilterAndSearch" resultMap="ImportOrderResponseMap">
        SELECT
            <include refid="baseColumns"/>,
            <include refid="updatedFields"/>
        <include refid="baseFromJoinForSelect"/>
        <include refid="whereClause"/>
        ORDER BY ${sortColumn} ${sortDirection}
        LIMIT #{limit}
        OFFSET #{offset}
    </select>

    <select id="countWithFilterAndSearch" resultType="long">
        SELECT COUNT(*)
        <include refid="baseFromJoinForCount"/>
        <include refid="whereClause"/>
    </select>

    <select id="findDetailsByImportOrderId" resultMap="ImportDetailResponseMap">
        SELECT
            id_detail.id,
            sn.product_variant_id,
            pv.sku AS product_variant_sku,
            pv.name AS product_variant_name,
            id_detail.serial_number_id,
            sn.serial_code,
            id_detail.unit_price,
            id_detail.created_at
        FROM import_details id_detail
        LEFT JOIN serial_numbers sn ON id_detail.serial_number_id = sn.id
        LEFT JOIN product_variants pv ON sn.product_variant_id = pv.id
        WHERE id_detail.import_order_id = #{importOrderId}
        ORDER BY id_detail.created_at ASC
    </select>

</mapper>
