<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.khahnm04.ecommerce.modules.inventory.mapper.mybatis.SerialMyBatisMapper">

    <resultMap id="SerialNumberResponseMap" type="com.khahnm04.ecommerce.modules.inventory.dto.response.SerialNumberResponse">
        <id property="id" column="id"/>
        <result property="serialCode" column="serial_code"/>
        <result property="productVariantId" column="product_variant_id"/>
        <result property="productVariantSku" column="product_variant_sku"/>
        <result property="productVariantName" column="product_variant_name"/>
        <result property="warehouseId" column="warehouse_id"/>
        <result property="warehouseName" column="warehouse_name"/>
        <result property="status" column="status" javaType="com.khahnm04.ecommerce.modules.inventory.enums.SerialNumberStatus"/>
        <result property="purchasePrice" column="purchase_price"/>
        <result property="soldPrice" column="sold_price"/>
        <result property="soldDate" column="sold_date"/>
        <result property="warrantyStartDate" column="warranty_start_date"/>
        <result property="warrantyEndDate" column="warranty_end_date"/>
        <result property="notes" column="notes"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <resultMap id="SerialMovementLogResponseMap" type="com.khahnm04.ecommerce.modules.inventory.dto.response.SerialMovementLogResponse">
        <id property="id" column="id"/>
        <result property="movementType" column="movement_type" javaType="com.khahnm04.ecommerce.modules.inventory.enums.SerialMovementType"/>
        <result property="fromWarehouseId" column="from_warehouse_id"/>
        <result property="fromWarehouseName" column="from_warehouse_name"/>
        <result property="toWarehouseId" column="to_warehouse_id"/>
        <result property="toWarehouseName" column="to_warehouse_name"/>
        <result property="referenceType" column="reference_type"/>
        <result property="referenceId" column="reference_id"/>
        <result property="movementDate" column="movement_date"/>
        <result property="notes" column="notes"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdByName" column="created_by_name"/>
    </resultMap>

    <sql id="baseColumns">
        sn.id,
        sn.serial_code,
        sn.product_variant_id,
        sn.warehouse_id,
        sn.status,
        sn.purchase_price,
        sn.sold_price,
        sn.sold_date,
        sn.warranty_start_date,
        sn.warranty_end_date,
        sn.notes,
        sn.created_at,
        sn.deleted_at
    </sql>

    <sql id="updatedFields">
        sn.updated_at,
        pv.sku AS product_variant_sku,
        pv.name AS product_variant_name,
        w.name AS warehouse_name,
        uc.full_name AS created_by,
        uu.full_name AS updated_by
    </sql>

    <sql id="baseFromJoinForSelect">
        FROM serial_numbers sn
        LEFT JOIN product_variants pv ON sn.product_variant_id = pv.id
        LEFT JOIN warehouses w ON sn.warehouse_id = w.id
        LEFT JOIN users uc ON sn.created_by = uc.id
        LEFT JOIN users uu ON sn.updated_by = uu.id
    </sql>

    <sql id="baseFromJoinForCount">
        FROM serial_numbers sn
    </sql>

    <sql id="whereClause">
        <where>
            AND sn.deleted_at IS NULL

            <!-- Product Variant filter -->
            <if test="productVariantId != null">
                AND sn.product_variant_id = #{productVariantId}
            </if>

            <!-- Warehouse filter -->
            <if test="warehouseId != null">
                AND sn.warehouse_id = #{warehouseId}
            </if>

            <!-- Status filter -->
            <if test="status != null">
                AND sn.status = #{status}
            </if>

            <!-- Keyword search -->
            <if test="keyword != null and keyword != ''">
                AND (
                    sn.serial_code LIKE CONCAT('%', #{keyword}, '%')
                    OR sn.notes LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>

            <!-- Date range filter -->
            <if test="startDate != null">
                AND sn.created_at >= #{startDate}
            </if>

            <!-- Date range filter -->
            <if test="endDate != null">
                <![CDATA[
                AND sn.created_at <= DATE_ADD(#{endDate}, INTERVAL 1 DAY) - INTERVAL 1 SECOND
                ]]>
            </if>
        </where>
    </sql>

    <select id="findAllWithFilterAndSearch" resultMap="SerialNumberResponseMap">
        SELECT
            <include refid="baseColumns"/>,
            <include refid="updatedFields"/>
        <include refid="baseFromJoinForSelect"/>
        <include refid="whereClause"/>
        ORDER BY ${sortColumn} ${sortDirection}
        LIMIT #{limit}
        OFFSET #{offset}
    </select>

    <select id="countWithFilterAndSearch" resultType="long">
        SELECT COUNT(*)
        <include refid="baseFromJoinForCount"/>
        <include refid="whereClause"/>
    </select>

    <select id="findMovementsBySerialId" resultMap="SerialMovementLogResponseMap">
        SELECT
            sml.id,
            sml.movement_type,
            sml.from_warehouse_id,
            fw.name AS from_warehouse_name,
            sml.to_warehouse_id,
            tw.name AS to_warehouse_name,
            sml.reference_type,
            sml.reference_id,
            sml.movement_date,
            sml.notes,
            sml.created_at,
            u.full_name AS created_by_name
        FROM serial_movement_logs sml
        LEFT JOIN warehouses fw ON sml.from_warehouse_id = fw.id
        LEFT JOIN warehouses tw ON sml.to_warehouse_id = tw.id
        LEFT JOIN users u ON sml.created_by = u.id
        WHERE sml.serial_number_id = #{serialNumberId}
        ORDER BY sml.movement_date DESC
    </select>

</mapper>
